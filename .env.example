APP_NAME="TeckFirm WiFi"
APP_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TeckFirm WiFi"

# PostgreSQL — local Docker default from docker-compose.yml
DATABASE_URL="postgresql://teckfirm:teckfirm@localhost:5432/teckfirm_wifi?schema=public"
# Same as DATABASE_URL locally. On Vercel, use the pooled Prisma URL for DATABASE_URL
# and the non-pooling URL for DIRECT_URL (needed for migrations).
DIRECT_URL="postgresql://teckfirm:teckfirm@localhost:5432/teckfirm_wifi?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Optional Google auth (leave empty until configured)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Paystack — use TEST keys in development. Never commit live secrets.
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# Omada Cloud Access (TP-Link ID). Server-side only. Never expose these to the browser.
# Device ID and Omada ID are stored per location in admin, not here.
OMADA_CLOUD_BASE_URL="https://euw1-api-omada-controller-connector.tplinkcloud.com"
OMADA_CLOUD_USERNAME=""
OMADA_CLOUD_PASSWORD=""

REDIS_URL="redis://localhost:6379"

EMAIL_FROM="TeckFirm WiFi <noreply@localhost>"
EMAIL_PROVIDER_API_KEY=""

# Local seed accounts are created only in development. Change these before any shared environment.
SEED_ADMIN_EMAIL="demo.admin@teckfirm.org"
SEED_ADMIN_PASSWORD="DemoAdmin123!"
SEED_CUSTOMER_EMAIL="demo.customer@example.com"
SEED_CUSTOMER_PASSWORD="DemoCustomer123!"
SEED_CUSTOMER_PHONE="+2348012345678"
